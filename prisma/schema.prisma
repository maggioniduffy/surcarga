// Vaca Muerta Logística — base data model.
// Structure only: see context/architecture-context.md for the models and
// invariants this schema implements. No business logic lives here.
//
// Model, table, column and enum-value names are English per code-standards.md.
// The Spanish domain vocabulary (viaje, carga, ubicación, postulación) lives in
// the UI copy under src/content/es/, never in identifiers.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

/// users.role — set once at signup (or granted for admin) and immutable
/// afterward. admin only unlocks locations edit/delete.
enum Role {
  carrier
  shipper
  admin
}

/// Distinguishes the two seed categories described in the location catalog:
/// base cities vs. known oilfields/operational sites.
enum LocationType {
  city
  oilfield
}

enum CargoStatus {
  pendingPayment @map("pending_payment")
  published
  confirmed
  completed

  @@map("cargo_status")
}

enum ApplicationStatus {
  pending
  confirmed
  rejected

  @@map("application_status")
}

enum PaymentProvider {
  mercadoPago @map("mercado_pago")
  stripe

  @@map("payment_provider")
}

enum PaymentStatus {
  pending
  approved
  rejected

  @@map("payment_status")
}

model User {
  id        String   @id @default(uuid())
  role      Role
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips            Trip[]
  cargos           Cargo[]
  applications     Application[]
  payments         Payment[]
  createdLocations Location[]    @relation("LocationCreatedBy")

  @@map("users")
}

model Location {
  id        String       @id @default(uuid())
  name      String       @unique
  type      LocationType
  latitude  Float
  longitude Float
  /// PostGIS point, kept in sync with latitude/longitude for proximity
  /// queries; not exposed on the generated Prisma Client.
  geom        Unsupported("geography(Point, 4326)")?
  createdById String?                                @map("created_by_id")
  createdBy   User?                                  @relation("LocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  originTrips       Trip[]  @relation("TripOrigin")
  destinationTrips  Trip[]  @relation("TripDestination")
  originCargos      Cargo[] @relation("CargoOrigin")
  destinationCargos Cargo[] @relation("CargoDestination")

  @@map("locations")
}

/// A carrier's published route. Free to publish, no payment gate.
model Trip {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  originId          String   @map("origin_id")
  origin            Location @relation("TripOrigin", fields: [originId], references: [id])
  destinationId     String   @map("destination_id")
  destination       Location @relation("TripDestination", fields: [destinationId], references: [id])
  availableCapacity String   @map("available_capacity")
  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@map("trips")
}

/// A shipper's published cargo need. Requires a confirmed payment before
/// it becomes publicly searchable (see architecture-context.md Invariant #1).
model Cargo {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  originId      String      @map("origin_id")
  origin        Location    @relation("CargoOrigin", fields: [originId], references: [id])
  destinationId String      @map("destination_id")
  destination   Location    @relation("CargoDestination", fields: [destinationId], references: [id])
  description   String
  neededDate    DateTime    @map("needed_date")
  urgent        Boolean     @default(false)
  status        CargoStatus @default(pendingPayment)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  applications Application[]
  payments     Payment[]

  @@map("cargos")
}

/// The connection/contact record between a trip and a cargo.
model Application {
  id            String            @id @default(uuid())
  tripId        String            @map("trip_id")
  trip          Trip              @relation(fields: [tripId], references: [id])
  cargoId       String            @map("cargo_id")
  cargo         Cargo             @relation(fields: [cargoId], references: [id])
  initiatedById String            @map("initiated_by_id")
  initiatedBy   User              @relation(fields: [initiatedById], references: [id])
  status        ApplicationStatus @default(pending)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("applications")
}

/// The fixed listing fee payment tied to publishing a cargo (Mercado Pago
/// primary, Stripe documented fallback only — see architecture-context.md).
model Payment {
  id         String          @id @default(uuid())
  cargoId    String          @map("cargo_id")
  cargo      Cargo           @relation(fields: [cargoId], references: [id])
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id])
  provider   PaymentProvider @default(mercadoPago)
  externalId String?         @map("external_id")
  amount     Decimal
  currency   String          @default("ARS")
  status     PaymentStatus   @default(pending)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@map("payments")
}
